{
  "id": "./",
  "name": "Deni Share",
  "short_name": "Deni Share",
  "description": "WebRTCでファイルを直接共有する、プライバシー重視のP2Pファイル転送アプリ。",
  "lang": "ja",
  "dir": "ltr",
  "categories": ["productivity", "utilities", "communication"],
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#f6f2f7",
  "theme_color": "#f6f2f7",
  "orientation": "any",
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    {
      "src": "./screen1.png",
      "sizes": "1220x1790",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Deni ShareのP2Pファイル共有画面"
    },
    {
      "src": "./screen2.png",
      "sizes": "1220x1785",
      "type": "image/png",
      "form_factor": "wide",
      "label": "スマートフォンでのDeni Shareファイル共有画面"
    }
  ],
  "shortcuts": [
    {
      "name": "ファイルを送る",
      "short_name": "送る",
      "description": "ファイル送信画面を開く",
      "url": "./index.html?shortcut=send",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "受信履歴",
      "short_name": "履歴",
      "description": "受信済みファイルを確認する",
      "url": "./index.html?shortcut=history",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "設定",
      "short_name": "設定",
      "description": "デバイス名やテーマを設定する",
      "url": "./index.html?shortcut=settings",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "launch_handler": {
    "route_to": "existing-client",
    "navigate_existing_client": "auto"
  },
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "files", "accept": ["*/*"] }]
    }
  }
}
